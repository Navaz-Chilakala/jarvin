{
  "manifest_version": 3,
  "name": "Jarvin: Share Current Page",
  "version": "0.1.0",
  "description": "Share the current tab once with Jarvin for review.",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html", "default_title": "Share current page with Jarvin" }
}
